{
  "name": "gym-progress-duo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test shared/*.test.ts tests/*.test.ts",
    "test:db": "node --test --test-concurrency=1 \"supabase/tests/*.test.js\"",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared tests e2e docs *.ts *.json *.html README.md",
    "format:check": "prettier --check src shared tests e2e docs *.ts *.json *.html README.md"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "8.16.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
